rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer/escribir su propio OTP
    match /otpCodes/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Cada usuario puede leer/escribir su propio documento
    match /usuarios/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Series: cualquier usuario autenticado puede leer;
    // solo escribe si es admin (ajusta según tu lógica)
    match /series/{serieId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
